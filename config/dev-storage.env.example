# Separate private Vercel project, PREVIEW only. Do not copy Production secrets.
# VERCEL_ENV and VERCEL_PROJECT_ID are Vercel system variables, not user overrides.
GATHERLY_V2_ENVIRONMENT=preview
GATHERLY_V2_DEV_STORAGE_ENABLED=true
GATHERLY_V2_DEV_VERCEL_PROJECT_ID=
GATHERLY_V2_DEV_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GATHERLY_V2_DEV_SUPABASE_SECRET_KEY=
GATHERLY_V2_DEV_TOKEN_ENCRYPTION_KEY=
GATHERLY_V2_DEV_WRITE_USER_ID=
GATHERLY_V2_PREVIEW_ALLOWED_USER_IDS=
GATHERLY_V2_INTEGRATION_ENABLED=true
GATHERLY_V2_AUTH_ONLY=true
GATHERLY_V2_VAULT_BACKEND=supabase
GATHERLY_V2_GOOGLE_CONSENT_ENABLED=true
GATHERLY_V2_GOOGLE_WRITES_ENABLED=false
# After independent dev setup + consent, enable once for this private dev deployment only.
GATHERLY_V2_APP_ORIGIN=
GATHERLY_V2_DEV_GOOGLE_CLIENT_ID=
GATHERLY_V2_DEV_GOOGLE_CLIENT_SECRET=
GATHERLY_V2_GOOGLE_REDIRECT_URI=
# Supabase Auth Google callback: https://<DEV_REF>.supabase.co/auth/v1/callback
# Supabase Site URL: <DEV_ORIGIN>; Redirect URL: <DEV_ORIGIN>/api/v2/auth/callback
# Separate file consent callback: <DEV_ORIGIN>/api/v2/google/callback
# Fresh 32-byte base64 server-only encryption key. Never rotate an existing key.
# New dev Supabase only: install existing consent-vault-minimal-reviewed.sql + readonly checks.
# Keep Production untouched. No schema/data/user/token copy. Initial dev Google login
# can show the caller's UID before adding that one UID to both allowlist variables.
# Require Vercel All Deployments protection; register fixed HTTPS dev origin.
