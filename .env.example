DATABASE_URL="file:./dev.db"
STORAGE_ROOT="./storage"
UPLOAD_MAX_IMAGE_BYTES="10485760"
UPLOAD_MAX_VIDEO_BYTES="262144000"
UPLOAD_MAX_AUDIO_BYTES="104857600"
RESEARCH_SOURCE_ROOT="./storage/research-sources"

# Google Drive / Docs source sync for NotebookLM handoff.
# NotebookLM itself is not called by API. These credentials are only for Google OAuth + Drive/Docs APIs.
GATHERLY_GOOGLE_CLIENT_ID=""
GATHERLY_GOOGLE_CLIENT_SECRET=""
GATHERLY_GOOGLE_REFRESH_TOKEN=""
# Optional. If empty, Gatherly creates/uses a top-level "Gatherly" folder.
GATHERLY_GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Gatherly → PlanFrame 보고서 연동
# 예: https://planframe.example.com/api/integrations/gatherly/reports
PLANFRAME_GATHERLY_ENDPOINT=""
PLANFRAME_GATHERLY_TOKEN=""

# Gatherly 전용 Telegram 상태 봇. 실제 값은 Git에 포함하지 않는 별도 환경 파일에 둡니다.
GATHERLY_TELEGRAM_BOT_TOKEN=""
GATHERLY_TELEGRAM_ALLOWED_USER_ID=""
GATHERLY_APP_HEALTH_URL="http://127.0.0.1:3001/api/health"
GATHERLY_ACCESS_URL=""
GATHERLY_STORAGE_PATH=""
GATHERLY_LOG_PATH=""
GATHERLY_DISK_WARN_PERCENT="80"
GATHERLY_DISK_CRITICAL_PERCENT="90"
GATHERLY_HEALTH_TIMEOUT_MS="5000"
GATHERLY_HEALTH_SLOW_MS="2000"
