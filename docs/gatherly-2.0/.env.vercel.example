# TEMPLATE ONLY: configure separately in Vercel Production and approved Preview.
# No local DATABASE_URL, filesystem paths, worker settings or legacy Google tokens.
NEXT_PUBLIC_SUPABASE_URL=https://rmjyonrmlbarvtaazurc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GATHERLY_V2_INTEGRATION_ENABLED=false
GATHERLY_V2_GOOGLE_WRITES_ENABLED=false
# Login-only validation avoids catalogue queries; does not authorize users.
GATHERLY_V2_AUTH_ONLY=true
# Separate file-access consent needs Vault provisioning, even with file writes off.
GATHERLY_V2_GOOGLE_CONSENT_ENABLED=false
GATHERLY_V2_APP_ORIGIN=https://your-stable-app.vercel.app
# Legacy GATHERLY_V2_ALLOWED_USER_IDS is no longer used by server authentication.
GATHERLY_V2_PREVIEW_ALLOWED_USER_IDS=
GATHERLY_V2_VAULT_BACKEND=supabase
# Server-only: required for private vault RPCs, NOT for public catalogue or SSR login.
GATHERLY_V2_SUPABASE_SECRET_KEY=
GATHERLY_V2_TOKEN_ENCRYPTION_KEY=
GATHERLY_V2_GOOGLE_CLIENT_ID=
GATHERLY_V2_GOOGLE_CLIENT_SECRET=
GATHERLY_V2_GOOGLE_REDIRECT_URI=https://your-stable-app.vercel.app/api/v2/google/callback
# VERCEL=1 is supplied by the platform, never copy it into local .env.

# Must match VERCEL_ENV on Vercel. Local development must use development.
GATHERLY_V2_ENVIRONMENT=preview
GATHERLY_V2_PRODUCTION_ALLOWED_USER_IDS=
GATHERLY_V2_DEVELOPMENT_ALLOWED_USER_IDS=
