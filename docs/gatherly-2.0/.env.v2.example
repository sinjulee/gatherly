# TEMPLATE ONLY. Do not replace legacy DATABASE_URL or GATHERLY_GOOGLE_*.
GATHERLY_V2_INTEGRATION_ENABLED=false
# Enable writes only AFTER approval of project, accounts and target files.
GATHERLY_V2_GOOGLE_WRITES_ENABLED=false
# Legacy GATHERLY_V2_ALLOWED_USER_IDS is no longer used by server authentication.
GATHERLY_V2_PREVIEW_ALLOWED_USER_IDS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GATHERLY_V2_APP_ORIGIN=https://your-approved-tailscale-host
GATHERLY_V2_GOOGLE_CLIENT_ID=
GATHERLY_V2_GOOGLE_CLIENT_SECRET=
GATHERLY_V2_GOOGLE_REDIRECT_URI=https://your-approved-tailscale-host/api/v2/google/callback
# 32 random bytes encoded as base64; never put a real key in this template.
GATHERLY_V2_TOKEN_ENCRYPTION_KEY=
# Private local directory outside repository/public/static serving. Single server only.
GATHERLY_V2_VAULT_DIR=
# Optional administrator provisioning tools only; runtime does not need these.
# GATHERLY_V2_SUPABASE_SECRET_KEY=
# GATHERLY_V2_DATABASE_URL=

# Must match VERCEL_ENV on Vercel. Local development must use development.
GATHERLY_V2_ENVIRONMENT=development
GATHERLY_V2_PRODUCTION_ALLOWED_USER_IDS=
GATHERLY_V2_DEVELOPMENT_ALLOWED_USER_IDS=
