generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Exhibition {
  id          String              @id @default(cuid())
  name        String
  nameEn      String?
  venue       String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  status      String              @default("DRAFT")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  fieldDays   FieldDay[]
  companies   ExhibitionCompany[]
  indexes     CurationIndex[]

  @@index([status, startDate])
}

model Company {
  id                   String              @id @default(cuid())
  externalId           String?
  name                 String
  nameEn               String?
  country              String?
  location             String?
  founded              Int?
  website              String?
  websiteDomain        String?
  companySummary       String?
  businessType         String?
  companySize          String?
  mainProductsJson     String?
  flagshipProduct      String?
  productSummary       String?
  targetCustomerJson   String?
  customerExamplesJson String?
  businessModel        String?
  coreTechnology       String?
  aiDigital            String?
  competitiveAdvantage String?
  competitorsJson      String?
  domesticMarket       String?
  globalMarket         String?
  growthSignals        String?
  funding              String?
  revenue              String?
  certificationsJson   String?
  recentNews           String?
  recentNewsDate       DateTime?
  source               String?
  lastChecked          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  exhibitions          ExhibitionCompany[]
  tags                 CompanyTag[]
  indexes              CompanyIndex[]
  materials            Material[]

  @@index([name])
  @@index([websiteDomain])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  kind      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  companies CompanyTag[]

  @@unique([name, kind])
  @@index([kind])
}

model CompanyTag {
  id         String   @id @default(cuid())
  companyId  String
  tagId      String
  source     String
  confidence Float?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([companyId, tagId])
  @@index([companyId])
  @@index([tagId])
}

model CurationIndex {
  id           String         @id @default(cuid())
  exhibitionId String
  name         String
  description  String?
  indexType    String
  icon         String?
  color        String?
  isSystem     Boolean        @default(false)
  isDynamic    Boolean        @default(false)
  ruleJson     String?
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  exhibition   Exhibition     @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  companies    CompanyIndex[]
  sourceMaterials Material[]

  @@unique([exhibitionId, name])
  @@index([exhibitionId])
  @@index([indexType])
}

model CompanyIndex {
  id        String        @id @default(cuid())
  companyId String
  indexId   String
  reason    String?
  priority  Int?
  sortOrder Int?
  source    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  index     CurationIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([companyId, indexId])
  @@index([indexId])
  @@index([companyId])
}

model ExhibitionCompany {
  id                       String     @id @default(cuid())
  exhibitionId             String
  companyId                String
  externalCompanyId        String?
  booth                    String?
  industry                 String?
  category                 String?
  exhibitionFocus          String?
  whyInteresting           String?
  benchmarkPoint           String?
  collaborationOpportunity String?
  fieldObservation         String?
  questionsJson            String?
  riskOrUnknown            String?
  rawTagsJson              String?
  source                   String?
  lastChecked              DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  exhibition               Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  company                  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([exhibitionId, companyId])
  @@index([exhibitionId])
  @@index([companyId])
  @@index([booth])
}

model FieldDay {
  id                          String              @id @default(uuid())
  title                       String
  location                    String?
  fieldDate                   DateTime            @default(now()) @map("date")
  description                 String?             @map("notes")
  status                      String              @default("ACTIVE")
  driveProjectFolderId        String?
  driveProjectFolderUrl       String?
  driveWorkspaceLinkedAt      DateTime?
  driveWorkspaceLastScannedAt DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  deletedAt                   DateTime?
  exhibitionId                String?
  exhibition                  Exhibition?         @relation(fields: [exhibitionId], references: [id], onDelete: SetNull)
  materials                   Material[]
  reports                     Report[]
  sourceBundles               SourceBundle[]
  analysisBriefs              AnalysisBrief[]
  notebookLink                NotebookLink?
  syncJobs                    SyncJob[]
  researchResults             ResearchResult[]
  quickAnalysisJobs           QuickAnalysisJob[]
  researchPlans               ResearchPlan[]
  preResearchSources          PreResearchSource[]

  @@index([status, deletedAt])
  @@index([driveProjectFolderId])
  @@index([exhibitionId])
}

model Material {
  id                String             @id @default(uuid())
  type              String
  title             String
  description       String?
  content           String?
  originalName      String?
  storedName        String?
  relativePath      String?            @map("filePath")
  mimeType          String?
  sizeBytes         Int?
  sha256            String?
  uploadStatus      String             @default("STORED")
  uploadError       String?
  clientUploadId    String?            @unique
  capturedAt        DateTime?
  reviewStatus      String             @default("COLLECTED")
  tagsJson          String?
  isImportant       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  fieldDayId        String?
  fieldDay          FieldDay?          @relation(fields: [fieldDayId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceIndexId     String?
  sourceIndex       CurationIndex?     @relation(fields: [sourceIndexId], references: [id], onDelete: SetNull)
  sourceBundleItems SourceBundleItem[]

  @@index([fieldDayId, deletedAt, createdAt])
  @@index([type, uploadStatus])
  @@index([reviewStatus, deletedAt])
  @@index([companyId, deletedAt, createdAt])
  @@index([sourceIndexId])
}

model Report {
  id                      String                      @id @default(cuid()) @map("report_id")
  title                   String
  status                  String                      @default("DRAFT")
  content                 String?
  instruction             String?
  reportVersion           Int                         @default(1) @map("report_version")
  structuredResult        String?                     @map("structured_result")
  structuredSchemaVersion String                      @default("gatherly.report.v1") @map("structured_schema_version")
  parentReportId          String?
  googleDocId             String?
  outputPath              String?
  errorMessageSafe        String?
  createdAt               DateTime                    @default(now())
  startedAt               DateTime?
  completedAt             DateTime?
  updatedAt               DateTime                    @updatedAt
  fieldDayId              String?
  fieldDay                FieldDay?                   @relation(fields: [fieldDayId], references: [id], onDelete: SetNull)
  parentReport            Report?                     @relation("ReportRevisions", fields: [parentReportId], references: [id], onDelete: SetNull)
  revisions               Report[]                    @relation("ReportRevisions")
  versions                ReportVersion[]
  integrationDeliveries   ReportIntegrationDelivery[]

  @@index([fieldDayId, createdAt])
  @@index([status, createdAt])
  @@index([parentReportId])
}

model SourceBundle {
  id              String             @id @default(cuid())
  fieldDayId      String
  version         Int                @default(1)
  title           String
  status          String             @default("DRAFT")
  manifestJson    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  fieldDay        FieldDay           @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)
  items           SourceBundleItem[]
  sourceDocuments SourceDocument[]
  analysisBriefs  AnalysisBrief[]
  syncJobs        SyncJob[]
  researchResults ResearchResult[]

  @@unique([fieldDayId, version])
  @@index([fieldDayId, status])
}

model SourceBundleItem {
  id             String       @id @default(cuid())
  sourceBundleId String
  materialId     String
  sourceType     String?
  sortOrder      Int          @default(0)
  included       Boolean      @default(true)
  sourceBundle   SourceBundle @relation(fields: [sourceBundleId], references: [id], onDelete: Cascade)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([sourceBundleId, materialId])
  @@index([materialId])
}

model SourceDocument {
  id             String       @id @default(cuid())
  sourceBundleId String
  documentType   String
  localPath      String?
  driveFileId    String?
  checksum       String?
  syncStatus     String       @default("PENDING")
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sourceBundle   SourceBundle @relation(fields: [sourceBundleId], references: [id], onDelete: Cascade)

  @@unique([sourceBundleId, documentType])
  @@index([syncStatus])
}

model AnalysisBrief {
  id                    String             @id @default(cuid())
  fieldDayId            String
  sourceBundleId        String?
  parentBriefId         String?
  version               Int                @default(1)
  title                 String
  goal                  String
  researchQuestions     String?
  decisionContext       String?
  evaluationCriteria    String?
  targetScope           String?
  excludeScope          String?
  outputType            String?
  additionalInstruction String?
  driveFileId           String?
  status                String             @default("DRAFT")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  fieldDay              FieldDay           @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)
  sourceBundle          SourceBundle?      @relation(fields: [sourceBundleId], references: [id], onDelete: SetNull)
  parentBrief           AnalysisBrief?     @relation("AnalysisBriefRevisions", fields: [parentBriefId], references: [id], onDelete: SetNull)
  revisions             AnalysisBrief[]    @relation("AnalysisBriefRevisions")
  syncJobs              SyncJob[]
  researchResults       ResearchResult[]
  quickAnalysisJobs     QuickAnalysisJob[]

  @@index([fieldDayId, status])
  @@index([sourceBundleId])
  @@index([parentBriefId])
}

model NotebookLink {
  id            String   @id @default(cuid())
  fieldDayId    String   @unique
  notebookUrl   String
  notebookLabel String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fieldDay      FieldDay @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)
}

model SyncJob {
  id               String         @id @default(cuid())
  fieldDayId       String
  sourceBundleId   String?
  analysisBriefId  String?
  jobType          String
  status           String         @default("PENDING")
  attemptCount     Int            @default(0)
  errorCode        String?
  errorMessageSafe String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  fieldDay         FieldDay       @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)
  sourceBundle     SourceBundle?  @relation(fields: [sourceBundleId], references: [id], onDelete: SetNull)
  analysisBrief    AnalysisBrief? @relation(fields: [analysisBriefId], references: [id], onDelete: SetNull)

  @@index([fieldDayId, status])
  @@index([sourceBundleId])
  @@index([analysisBriefId])
}

model QuickAnalysisJob {
  id               String         @id @default(cuid())
  fieldDayId       String
  analysisBriefId  String?
  title            String
  instruction      String
  status           String         @default("QUEUED")
  resultMarkdown   String?
  outputPath       String?
  errorMessageSafe String?
  queuedAt         DateTime       @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt
  fieldDay         FieldDay       @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)
  analysisBrief    AnalysisBrief? @relation(fields: [analysisBriefId], references: [id], onDelete: SetNull)

  @@index([fieldDayId, queuedAt])
  @@index([status, queuedAt])
  @@index([analysisBriefId])
}

model ResearchResult {
  id              String          @id @default(cuid())
  fieldDayId      String
  sourceBundleId  String
  analysisBriefId String
  title           String
  googleDocId     String?
  importedAt      DateTime        @default(now())
  status          String          @default("IMPORTED")
  version         Int             @default(1)
  fieldDay        FieldDay        @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)
  sourceBundle    SourceBundle    @relation(fields: [sourceBundleId], references: [id], onDelete: Restrict)
  analysisBrief   AnalysisBrief   @relation(fields: [analysisBriefId], references: [id], onDelete: Restrict)
  reportVersions  ReportVersion[]

  @@index([fieldDayId, status])
  @@index([sourceBundleId])
  @@index([analysisBriefId])
}

model ReportVersion {
  id String @id @default(cuid())

  reportId                String?
  reportVersion           Int?    @map("report_version")
  versionType             String  @default("DRAFT")
  content                 String?
  structuredResult        String? @map("structured_result")
  structuredSchemaVersion String  @default("gatherly.report.v1") @map("structured_schema_version")
  createdBy               String  @default("SYSTEM")

  researchResultId  String?
  versionNo         Int?
  title             String?
  googleDocId       String?
  localSnapshotPath String?
  revisionReason    String?

  status    String   @default("DRAFT")
  createdAt DateTime @default(now())

  report                Report?                     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  researchResult        ResearchResult?             @relation(fields: [researchResultId], references: [id], onDelete: Cascade)
  revisionRequests      RevisionRequest[]
  integrationDeliveries ReportIntegrationDelivery[]

  @@unique([reportId, reportVersion])
  @@unique([researchResultId, versionNo])
  @@index([reportId, createdAt])
  @@index([researchResultId, createdAt])
  @@index([status])
}

model RevisionRequest {
  id              String        @id @default(cuid())
  reportVersionId String
  type            String
  instruction     String
  status          String        @default("OPEN")
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?
  reportVersion   ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId, status])
}

model ReportIntegrationDelivery {
  id               String        @id @default(cuid())
  reportId         String
  reportVersionId  String
  destination      String        @default("PLANFRAME")
  idempotencyKey   String        @unique
  status           String        @default("QUEUED")
  attempt          Int           @default(0)
  payloadHash      String?
  httpStatus       Int?
  externalReportId String?
  sentAt           DateTime?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  report           Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportVersion    ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportId, destination, status])
  @@index([reportVersionId, destination])
}

model ResearchPlan {
  id              String               @id @default(cuid())
  fieldDayId      String
  parentPlanId    String?
  version         Int                  @default(1)
  status          String               @default("DRAFT")
  isActive        Boolean              @default(false)
  title           String
  objective       String
  background      String?
  visitPurpose    String?
  decisionContext String?
  targetScope     String?
  successCriteria String?
  preResearchText String?
  generatedByAi   Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  activatedAt     DateTime?
  closedAt        DateTime?
  fieldDay        FieldDay             @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)
  parentPlan      ResearchPlan?        @relation("ResearchPlanVersions", fields: [parentPlanId], references: [id], onDelete: SetNull)
  childPlans      ResearchPlan[]       @relation("ResearchPlanVersions")
  targets         ResearchTarget[]
  questions       ResearchQuestion[]
  checkpoints     ResearchCheckpoint[]

  @@unique([fieldDayId, version])
  @@index([fieldDayId, status])
  @@index([fieldDayId, isActive])
  @@index([parentPlanId])
}

model ResearchTarget {
  id             String               @id @default(cuid())
  researchPlanId String
  name           String
  type           String               @default("OTHER")
  boothNo        String?
  locationHint   String?
  description    String?
  priority       String               @default("P2")
  visitOrder     Int                  @default(0)
  visitStatus    String               @default("PLANNED")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  researchPlan   ResearchPlan         @relation(fields: [researchPlanId], references: [id], onDelete: Cascade)
  questions      ResearchQuestion[]
  checkpoints    ResearchCheckpoint[]

  @@index([researchPlanId, visitOrder])
  @@index([researchPlanId, visitStatus])
}

model ResearchQuestion {
  id             String               @id @default(cuid())
  researchPlanId String
  targetId       String?
  question       String
  rationale      String?
  priority       String               @default("P2")
  sortOrder      Int                  @default(0)
  status         String               @default("OPEN")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  researchPlan   ResearchPlan         @relation(fields: [researchPlanId], references: [id], onDelete: Cascade)
  target         ResearchTarget?      @relation(fields: [targetId], references: [id], onDelete: SetNull)
  checkpoints    ResearchCheckpoint[]

  @@index([researchPlanId, sortOrder])
  @@index([targetId])
}

model ResearchCheckpoint {
  id                  String             @id @default(cuid())
  researchPlanId      String
  targetId            String?
  researchQuestionId  String?
  title               String
  description         String?
  priority            String             @default("P2")
  status              String             @default("NOT_STARTED")
  evidenceRequirement String?
  completionNote      String?
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  researchPlan        ResearchPlan       @relation(fields: [researchPlanId], references: [id], onDelete: Cascade)
  target              ResearchTarget?    @relation(fields: [targetId], references: [id], onDelete: SetNull)
  researchQuestion    ResearchQuestion?  @relation(fields: [researchQuestionId], references: [id], onDelete: SetNull)
  requiredEvidence    RequiredEvidence[]

  @@index([researchPlanId, sortOrder])
  @@index([targetId])
  @@index([researchQuestionId])
  @@index([researchPlanId, priority, status])
}

model RequiredEvidence {
  id           String             @id @default(cuid())
  checkpointId String
  evidenceType String             @default("ANY")
  minimumCount Int                @default(1)
  requireText  Boolean            @default(false)
  requireFile  Boolean            @default(false)
  description  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  checkpoint   ResearchCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId])
}

model PreResearchSource {
  id              String   @id @default(cuid())
  fieldDayId      String
  driveFileId     String
  name            String
  mimeType        String?
  webViewLink     String?
  modifiedTime    DateTime?
  sourceType      String   @default("OTHER")
  selectedForPlan Boolean  @default(false)
  contentHash     String?
  lastScannedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fieldDay        FieldDay @relation(fields: [fieldDayId], references: [id], onDelete: Cascade)

  @@unique([fieldDayId, driveFileId])
  @@index([fieldDayId, selectedForPlan])
  @@index([fieldDayId, modifiedTime])
}
